{
  "name": "agentpay-near-check",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-payment delivery check and paid fetch for agents that hold funds on NEAR.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "near-check": "./bin/near-check.mjs"
  },
  "scripts": {
    "check": "node bin/near-check.mjs check",
    "quote": "node bin/near-check.mjs quote",
    "buy": "node --env-file-if-exists=../.env --env-file-if-exists=.env bin/near-check.mjs buy",
    "hire": "node --env-file-if-exists=../.env --env-file-if-exists=.env bin/near-check.mjs hire",
    "sweep": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/sweep.mjs",
    "test": "node --test",
    "page": "node src/page.mjs",
    "funding": "node src/funding.mjs"
  },
  "dependencies": {
    "@fastnear/x402": "^2.5.0",
    "@romudille/x402-guard": "^0.1.1",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/near": "^2.30.0",
    "near-api-js": "^7.5.3",
    "viem": "^2.57.19"
  }
}