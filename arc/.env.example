# Fresh key for the probe only. Never the gateway key.
ARC_PRIVATE_KEY=0x...
# Printed by `npm run deploy`; leave empty to skip on-chain attestation.
ARC_ANCHOR_ADDRESS=
# Hard cap for one probe run, in USDC.
ARC_MAX_SPEND=1.00
# Optional: how much to deposit into Circle Gateway before paying batched listings (default 0.25).
ARC_GATEWAY_DEPOSIT=0.25
