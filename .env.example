# ── Stellar Network ──────────────────────────────────────
# Options: testnet | mainnet
STELLAR_NETWORK=testnet

# Gateway wallet (receives payments, splits to tool devs)
GATEWAY_SECRET_KEY=              # Your gateway Stellar secret key (never commit)
GATEWAY_PUBLIC_KEY=GB7THTEVT2T7CZQ5TFUOIQSI32XCJ7BHWS35OBTAI2V4FNL7BXZZ2GM2

# Gateway fee percentage (0.15 = 15%)
GATEWAY_FEE_PERCENT=0.15

# ── Server ───────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Database (Supabase) ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ── External APIs (for tools) ────────────────────────────
# CoinGecko (free tier, no key needed for basic use)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Etherscan (free API key at etherscan.io)
ETHERSCAN_API_KEY=your-etherscan-key

# ── OpenAI (for LangGraph agent) ─────────────────────────
OPENAI_API_KEY=sk-...

# ── Payment Config ────────────────────────────────────────
# USDC asset on Stellar testnet
USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ── Stacks / sBTC settlement (optional rail) ──────────────
# Off unless STACKS_ENABLED=true and a payee address is set. The gateway
# broadcasts client-signed sBTC transfers and receives at STACKS_GATEWAY_ADDRESS;
# it never signs, so the payee needs no STX. Payers pay their own STX fee.
STACKS_ENABLED=false
STACKS_NETWORK=testnet                 # testnet | mainnet
STACKS_GATEWAY_ADDRESS=                # ST… on testnet, SP… on mainnet
# Derived from STACKS_NETWORK when blank:
STACKS_HIRO_API=                       # https://api.testnet.hiro.so | https://api.hiro.so
STACKS_SBTC_CONTRACT=                  # SN3VMH…sbtc-token | SM3VDX…sbtc-token
STACKS_FACILITATOR_URL=                # blank = direct Hiro broadcast
# USD→sats quote: live CoinGecko, cached STACKS_RATE_CACHE_S; STACKS_FIXED_BTC_USD
# is the fallback when the live fetch fails.
STACKS_RATE_CACHE_S=60
STACKS_FIXED_BTC_USD=
# STX fee offered on the 402: max(Hiro medium-tier estimate, SUGGESTED) up to CAP.
STACKS_SUGGESTED_FEE_MICROSTX=3000
STACKS_FEE_ESTIMATE=true
STACKS_FEE_CAP_MICROSTX=20000
# Whole settle (broadcast + confirm) bound; past it the reply is "uncertain"
# (redeemable). Keep under the edge's 100 s timeout.
STACKS_SETTLE_DEADLINE_S=75
# Testnet only: give the demo a priced tool ("token_price:0.01"). Leave unset on mainnet.
TESTNET_PAID_TOOLS=
